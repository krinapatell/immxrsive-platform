{
  "release": "R2",
  "project_option": "talent_discovery_platform",
  "deployment_url": "https://immxrsive-platform.vercel.app",
  "repository_url": "https://github.com/krinapatell/immxrsive-platform",
  "tag": "R2-submission",
  "entry_points": {
    "directory": "/",
    "student_portal": "/student",
    "api_profiles": "/api/profiles"
  },
  "roles": {
    "public_employer": {
      "access": "unauthenticated",
      "allowed_actions": ["view_directory", "filter_candidates", "view_project_cards"]
    },
    "algoma_student": {
      "access": "otp_verified",
      "domain_restriction": "@algomau.ca",
      "allowed_actions": ["edit_profile", "upload_resume", "extract_skills", "publish_profile"]
    }
  },
  "fixtures": {
    "resumes": [
      "resume_clean_single_column.pdf",
      "resume_layout_stress.pdf",
      "resume_minimal.pdf",
      "resume_untrusted_text.pdf"
    ]
  }
}
